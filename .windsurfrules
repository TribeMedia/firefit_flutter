# FireFit Flutter - Code Generation Rules
description: "FireFit Flutter - Cursor AI Configuration for Flutter code generation"
filePattern: "**/*"
applyAutomatically: false

frameworks:
  - "Flutter"
  - "Dart"
  - "hooks_riverpod"
  - "go_router"
  - "clean architecture"

rules:
  general:
    - rule: "Follow feature-based clean architecture structure as specified in docs/CONFIG_AI.md"
      severity: "error"
    - rule: "Create modular, reusable components with clear separation of concerns"
      severity: "warning"
    - rule: "Follow patterns and examples in docs/EXAMPLE_FEATURE_STRUCTURE.md"
      severity: "warning"
    - rule: "When tackling complex problems, use appropriate reasoning method from docs/LLM_ROUTING.md"
      severity: "info"
    - rule: "First understand issues, propose a plan before implementing"
      severity: "warning"
    - rule: "Provide solutions that integrate well with existing code"
      severity: "error"

  architecture:
    - rule: "Implement clean architecture with domain, data, and presentation layers"
      severity: "error"
    - rule: "Follow TypeScript configurations in analysis_options.yaml"
      severity: "error"
    - rule: "Avoid dynamic type usage (explicit or implicit)"
      severity: "error"
    - rule: "Use snake_case for all filenames"
      severity: "error"
    - rule: "Organize code by feature rather than layer"
      severity: "warning"
    - rule: "Implement dependency injection with Riverpod"
      severity: "error"
    - rule: "Domain layer contains entities, repository interfaces, failures, and validation logic"
      severity: "info"
    - rule: "Data layer contains repository implementations, data sources, and DTOs"
      severity: "info"
    - rule: "Presentation layer contains screens, widgets, and view models (AsyncNotifiers)"
      severity: "info"

  verification:
    - rule: "Check package versions in pubspec.yaml for compatibility"
      severity: "warning"
    - rule: "Verify API usage against project implementations"
      severity: "warning"
    - rule: "Research current best practices via firecrawl MCP server"
      severity: "info"

  structure:
    featureBased:
      - path: "lib/features/[feature_name]/"
        children:
          - path: "domain/"
            description: "Entities, repository interfaces, failures, validation"
          - path: "data/"
            description: "Repository implementations, data sources, DTOs"
          - path: "presentation/"
            description: "Screens, widgets, view models"
      - path: "lib/core/"
        children:
          - path: "error/"
            description: "Error handling (failures, exceptions)"
          - path: "util/"
            description: "Utility functions and extensions"
          - path: "network/"
            description: "Network-related code (API clients, interceptors)"
      - path: "lib/app/"
        children:
          - path: "router/"
            description: "Routing configuration"
          - path: "theme/"
            description: "Theme configuration"
          - path: "localization/"
            description: "Localization configuration"

  stateManagement:
    - rule: "Use AsyncNotifier for async operations"
      severity: "warning"
    - rule: "Use StateNotifier for synchronous state management"
      severity: "warning"
    - rule: "Organize providers by feature"
      severity: "warning"
    - rule: "Implement error handling with AsyncValue"
      severity: "error"
    - rule: "Create proper loading states"
      severity: "warning"
    - rule: "Use hooks_riverpod for state management"
      severity: "error"
    - rule: "Use flutter_hooks for local component state and lifecycle management"
      severity: "warning"
    - rule: "Implement proper loading, error, and data states using AsyncValue"
      severity: "error"

  authentication:
    - rule: "Create AuthRepository in domain layer"
      severity: "error"
    - rule: "Implement error handling with Either<Failure, Success>"
      severity: "error"
    - rule: "Use secure storage for tokens"
      severity: "error"
    - rule: "Implement token refresh mechanisms"
      severity: "error"
    - rule: "Use go_router for protected routes"
      severity: "warning"

  testing:
    - rule: "Write unit tests for repository implementations"
      severity: "warning"
    - rule: "Write widget tests for UI components"
      severity: "warning"
    - rule: "Write integration tests for key user flows"
      severity: "warning"
    - rule: "Use mocktail for mocking dependencies"
      severity: "info"
    - rule: "Follow testing templates in docs/TESTING_TEMPLATES.md"
      severity: "info"
    - rule: "Aim for high test coverage, especially for business logic in domain and data layers"
      severity: "warning"

  bugFixing:
    - rule: "Set checkpoints before code changes"
      severity: "warning"
    - rule: "Generate memory for multi-step solutions"
      severity: "info"
    - rule: "Use memory-oriented tools and MCP servers"
      severity: "info"
    - rule: "Focus only on the specific bug in the file"
      severity: "error"
    - rule: "Avoid enhancements during bug fixing"
      severity: "error"
    - rule: "Focus on robust error handling using Either<Failure, Success> pattern for repositories"
      severity: "error"

  typeManagement:
    - rule: "Check codebase before creating new types"
      severity: "error"
    - rule: "Follow prescribed directory structure"
      severity: "warning"
    - rule: "Use freezed for immutable models"
      severity: "warning"
    - rule: "Use json_serializable for JSON serialization"
      severity: "warning"
    - rule: "Use strong typing throughout the codebase"
      severity: "error"
    - rule: "Prevent type duplication by checking for existing types"
      severity: "error"

  packageManagement:
    - rule: "Use Flutter's pub for package management"
      severity: "info"
    - rule: "Run 'flutter pub get' after adding dependencies"
      severity: "warning"
    - rule: "Run 'dart run build_runner build --delete-conflicting-outputs' for code generation"
      severity: "warning"

  codeStyle:
    - rule: "Prefer functional patterns"
      severity: "warning"
    - rule: "Use snake_case for file and directory names"
      severity: "error"
    - rule: "Use camelCase for variable and function names"
      severity: "error"
    - rule: "Use PascalCase for class, enum, and typedef names"
      severity: "error"
    - rule: "Use kConstantName for constants"
      severity: "warning"
    - rule: "Follow the official Dart style guide"
      severity: "error"
    - rule: "Use dart format tool to ensure consistent formatting"
      severity: "warning"
    - rule: "Maintain existing comments"
      severity: "warning"
    - rule: "Add documentation comments for public APIs and complex functions"
      severity: "warning"

  completionPlan:
    - rule: "Follow the completion plan in docs/COMPLETION_PLAN.md"
      severity: "info"
    - rule: "Follow execution guidelines in docs/AI_EXECUTION_GUIDE.md"
      severity: "info"
    - rule: "Ensure all features meet success criteria in docs/AI_EXECUTION_GUIDE.md"
      severity: "warning"

  personality:
    - rule: "Follow personality profile defined in docs/AI_PERSONALITY.md"
      severity: "info"
    - rule: "Use clear, concise, technical language as specified in docs/AI_PERSONALITY.md"
      severity: "info"
    - rule: "Apply methodical problem-solving approach from docs/AI_PERSONALITY.md"
      severity: "info"