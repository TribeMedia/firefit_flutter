# Flutter Responsive UI Design Guidelines

These guidelines ensure Flutter applications feel instantly responsive, even when waiting for backend operations. The key principle is that perceived performance is just as important as actual performance.

## Core Principles for Responsive UI

1. **Instant Feedback**: Always provide immediate visual feedback when users interact with the UI
2. **Prevent Layout Shifts**: Reserve space for dynamic content to avoid jarring layout changes
3. **Use Skeleton Loaders**: Show content-shaped placeholders during loading instead of spinners
4. **Optimize Event Handling**: Debounce input and throttle scroll events to prevent jank
5. **Add Micro-interactions**: Include subtle animations and transitions for a more responsive feel
6. **Handle Errors Gracefully**: Provide clear error states and recovery options

## AsyncNotifier Implementation Best Practices

When implementing AsyncNotifiers with GraphQL in hooks_riverpod, follow these patterns:

```dart
// CORRECT: AsyncNotifier with immediate loading feedback
class ProductsNotifier extends AsyncNotifier<List<Product>> {
  @override
  Future<List<Product>> build() async {
    // Set loading state IMMEDIATELY for responsive UI
    state = const AsyncValue.loading();
    
    return AsyncValue.guard(() async {
      final result = await _repository.queryProducts();
      return result.fold(
        (failure) => throw failure, // AsyncValue.guard will catch this
        (data) => data,
      );
    }).then((value) => value.hasValue ? value.value! : []);
  }
  
  // CORRECT: Optimistic update pattern for mutations
  Future<void> createProduct(ProductInput input) async {
    // Store previous state for rollback
    final previous = state;
    
    // Optimistically update UI before API call
    final optimisticProduct = Product.fromInput(input);
    state = AsyncValue.data([...previous.asData!.value, optimisticProduct]);
    
    // Perform actual mutation
    final result = await _repository.createProduct(input: input);
    
    // Handle result
    result.fold(
      (failure) {
        // Revert to previous state on failure
        state = previous;
      },
      (product) {
        // Update with actual data from server
        final currentList = [...previous.asData!.value];
        currentList.removeWhere((e) => e.id == optimisticProduct.id);
        state = AsyncValue.data([...currentList, product]);
      },
    );
  }
}
```

## Reactive Forms Implementation

For Flutter Reactive Forms, implement these patterns for better responsiveness:

```dart
// CORRECT: Form with loading state and optimistic updates
class ProductFormView extends ConsumerStatefulWidget {
  final String? productId; // Null for create, non-null for edit
  
  const ProductFormView({Key? key, this.productId}) : super(key: key);
  
  @override
  _ProductFormViewState createState() => _ProductFormViewState();
}

class _ProductFormViewState extends ConsumerState<ProductFormView> {
  late FormGroup _form;
  bool _isSubmitting = false;
  
  @override
  void initState() {
    super.initState();
    _form = FormGroup({
      'name': FormControl<String>(
        value: '',
        validators: [Validators.required],
      ),
      'description': FormControl<String>(value: ''),
      'price': FormControl<double>(value: 0.0),
    });
    
    // Load entity data if editing
    if (widget.productId != null) {
      _loadProductData();
    }
  }
  
  Future<void> _loadProductData() async {
    // Show loading state immediately
    setState(() {
      _form.markAsPending();
    });
    
    // Load data
    final productDetail = ref.read(productDetailProvider.notifier);
    productDetail.initialize(widget.productId!);
  }
  
  // CORRECT: Form submission with loading state feedback
  Future<void> _submitForm() async {
    if (!_form.valid) {
      _form.markAllAsTouched();
      return;
    }
    
    // Show submitting state immediately
    setState(() {
      _isSubmitting = true;
    });
    
    try {
      final formValues = _form.rawValue;
      final input = ProductInput(
        name: formValues['name'] as String,
        description: formValues['description'] as String,
        price: formValues['price'] as double,
      );
      
      if (widget.productId != null) {
        // Update existing
        await ref.read(productDetailProvider.notifier).update(input);
      } else {
        // Create new
        await ref.read(productCollectionProvider.notifier).create(input);
      }
      
      if (mounted) {
        // Show success and navigate back
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(content: Text('Product saved successfully')),
        );
        Navigator.of(context).pop();
      }
    } catch (e) {
      if (mounted) {
        // Show error
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text('Error: ${e.toString()}')),
        );
      }
    } finally {
      if (mounted) {
        setState(() {
          _isSubmitting = false;
        });
      }
    }
  }
  
  @override
  Widget build(BuildContext context) {
    // ...form UI implementation with proper loading states
  }
}
```

