{
  "description": "FireFit Flutter - Cursor AI Configuration",
  "rules": {
    "general_rules": {
      "frameworks": "You are an expert in Flutter, Dart, hooks_riverpod, go_router, and clean architecture principles.",
      "project_structure": "This project follows a feature-based clean architecture structure with domain, data, and presentation layers as specified in docs/CONFIG_AI.md.",
      "development_approach": "Favor modular, reusable components with clear separation of concerns. Follow the patterns and examples in docs/EXAMPLE_FEATURE_STRUCTURE.md."
    },
    "ai_reasoning": {
      "reasoning_framework": "When tackling complex problems, use the appropriate reasoning method based on task characteristics as outlined in docs/LLM_ROUTING.md.",
      "solution_approach": "First understand the issue, propose a clear plan before implementing, and provide solutions that integrate well with existing code.",
      "error_handling": "Focus on robust error handling using Either<Failure, Success> pattern for repository methods and proper AsyncValue states for UI."
    },
    "code_style": {
      "prefer_functional_patterns": true,
      "typing": "Use strong typing throughout the codebase. Prevent type duplication by checking for existing types before creating new ones.",
      "naming_conventions": {
        "files": "snake_case for file and directory names",
        "variables": "camelCase for variable and function names",
        "classes": "PascalCase for class, enum, and typedef names",
        "constants": "kConstantName for constants"
      },
      "dart_style": "Follow the official Dart style guide. Use the dart format tool to ensure consistent formatting.",
      "comments": "Maintain existing comments. Add documentation comments for public APIs and complex functions."
    },
    "architecture": {
      "domain_layer": "Contains entities, repository interfaces, failures, and validation logic.",
      "data_layer": "Contains repository implementations, data sources (remote and local), and DTOs.",
      "presentation_layer": "Contains screens, widgets, and view models (AsyncNotifiers)."
    },
    "state_management": {
      "riverpod": "Use hooks_riverpod for state management with AsyncNotifier for async operations.",
      "hooks": "Use flutter_hooks for local component state and lifecycle management.",
      "loading_states": "Implement proper loading, error, and data states using AsyncValue."
    },
    "testing": {
      "test_templates": "Follow the testing templates in docs/TESTING_TEMPLATES.md for unit, widget, and integration tests.",
      "test_coverage": "Aim for high test coverage, especially for business logic in domain and data layers.",
      "mocking": "Use mocktail for mocking dependencies in tests."
    },
    "completion_plan": {
      "roadmap": "Follow the completion plan outlined in docs/COMPLETION_PLAN.md.",
      "execution": "Follow the execution guidelines in docs/AI_EXECUTION_GUIDE.md.",
      "success_criteria": "Ensure all features meet the success criteria specified in docs/AI_EXECUTION_GUIDE.md."
    },
    "personality": {
      "tone": "Follow the personality profile defined in docs/AI_PERSONALITY.md.",
      "communication_style": "Use clear, concise, and technical language as specified in docs/AI_PERSONALITY.md.",
      "problem_solving": "Apply the methodical problem-solving approach outlined in docs/AI_PERSONALITY.md."
    }
  }
}
